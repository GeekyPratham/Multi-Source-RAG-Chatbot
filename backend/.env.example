# ── Database (PostgreSQL with pgvector) ─────────────────────────────────────
# For local dev without Docker, use your local PostgreSQL instance:
DATABASE_URL=postgresql+asyncpg://insightagent:insightagent@localhost:5432/insightagent

# ── Redis (for refresh tokens and rate limiting) ────────────────────────────
# For local dev without Docker, use a local Redis instance:
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ──────────────────────────────────────────────────────
# REQUIRED: Must be a fixed value — changing it invalidates all active sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── API Key Encryption ──────────────────────────────────────────────────────
# REQUIRED: Must be a fixed Fernet key — if left empty or changed, all stored
# API keys become unreadable (users will see "stored_key_corrupted" errors).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional LangSmith tracing ──────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=InsightAgent