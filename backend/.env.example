# ── Database (PostgreSQL with pgvector) ─────────────────────────────────────
# For local dev without Docker, use your local PostgreSQL instance:
DATABASE_URL=postgresql+asyncpg://insightagent:insightagent@localhost:5432/insightagent

# ── Redis (for refresh tokens and rate limiting) ────────────────────────────
# For local dev without Docker, use a local Redis instance:
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ──────────────────────────────────────────────────────
# Change this in production to a long random string!
JWT_SECRET_KEY=change-this-in-production
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── API Key Encryption ──────────────────────────────────────────────────────
# Used to encrypt users' LLM provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key will be auto-generated (won't persist across restarts).
ENCRYPTION_KEY=

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional LangSmith tracing ──────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=InsightAgent